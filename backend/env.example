############################################
# Application Environment
############################################
# One of: local, development, staging, production
APP_ENV=local
# Optional explicit env file override (e.g., .env.local)
# APP_ENV_FILE=

############################################
# Database Configuration
############################################
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=safety_ai_db

############################################
# Security
############################################
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_ACCESS_TOKEN_EXPIRE_DAYS=30

############################################
# AI Model Configuration
############################################
YOLO_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
NMS_THRESHOLD=0.4

############################################
# Video Processing
############################################
FRAME_RATE=30
FRAME_WIDTH=640
FRAME_HEIGHT=480

############################################
# File Storage
############################################
UPLOAD_DIR=uploads
ALERTS_DIR=alerts

############################################
# Logging
############################################
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

############################################
# CORS
############################################
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
